# Current non-secret project settings; confirm for the target deployment.
# Copy to .env.local and supply the three blank secrets separately.
NEXT_PUBLIC_SANITY_PROJECT_ID=ocxfzm61
NEXT_PUBLIC_SANITY_DATASET_FULL_WEBSITE=full-website
NEXT_PUBLIC_SANITY_API_VERSION=2024-07-09

# Local development: http://localhost:3000
# Production: the canonical public HTTPS URL, without a trailing slash.
NEXT_PUBLIC_BASE_URL=https://www.theperrie.com

# Required server-only Sanity project read token.
SANITY_API_READ_TOKEN=

# Registration: the current code uses the Mailchimp us14 data center.
MAILCHIMP_AUDIENCE_ID=1a1a594ba4
MAILCHIMP_API_KEY=

# Registration notifications: must allow sending from register@theperrie.com.
RESEND_API_KEY=
